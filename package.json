{
  "name": "@cesarvenzac/roll",
  "version": "0.1.3",
  "description": "Text that rolls as it changes: digits turn like an odometer's and keep their places, letters and icons roll over, on springs that carry on when interrupted. No dependencies.",
  "keywords": [
    "roll",
    "rolling",
    "odometer",
    "counter",
    "number",
    "number-animation",
    "animated-number",
    "ticker",
    "slot",
    "split-flap",
    "digits",
    "text-animation",
    "spring",
    "animation",
    "react"
  ],
  "homepage": "https://cesarvenzac.com/roll",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cesarvenzac/roll.git"
  },
  "bugs": "https://github.com/cesarvenzac/roll/issues",
  "author": "César Venzac (https://cesarvenzac.com)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "sh check/run.sh",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
